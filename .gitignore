# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.ruff_cache/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Node / Angular frontend
node_modules/
npm-debug.log*
pnpm-debug.log*
# Angular build output (re-generated by the frontend build)
backend/static/*.js
backend/static/*.css
backend/static/favicon.ico
backend/static/3rdpartylicenses.txt
backend/static/prerendered-routes.json
backend/static/index.html
backend/static/media/

# Work / temp directories used by the recompress worker
/tmp/immich_recompress_ui/
/tmp/immich_recompress_backup/
tmp/

# Persisted job history (SQLite)
immich_recompress.db
*.db-journal

# OS / editor
.DS_Store
.idea/
.vscode/
*.log

# Local environment files
.env

# Local agent state. .claude is a symlink to .agents, so the files Claude Code
# writes land here and its own .claude ignore rules do not match them.
.agents/settings.local.json
.agents/scheduled_tasks.lock
.agents/scheduled_tasks.json
.agents/routines/.state/
.agents/worktrees/
.agents/checkpoints/
.agents/mailbox/
.agents/agent-registry.json
.agents/agent-memory-local
.agents/first-run
.agents/assistant-daemon-state.json
